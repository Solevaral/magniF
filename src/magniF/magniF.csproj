<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- WinForms нужен только ради System.Drawing (отрисовка рамки лупы и иконки трея). -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>magniF</AssemblyName>
    <RootNamespace>magniF</RootNamespace>
    <Version>1.0.1</Version>
    <Product>magniF</Product>
    <Description>Hold-to-zoom magnifier that follows the cursor.</Description>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- WFO0003: DPI-осведомлённость задана в манифесте намеренно — это WPF-приложение. -->
    <NoWarn>$(NoWarn);SYSLIB1054;WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
    <EmbeddedResource Include="UI\LensShader.hlsl" LogicalName="magniF.UI.LensShader.hlsl" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Vortice.D3DCompiler" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DirectComposition" Version="3.8.3" />
  </ItemGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <!-- Vortice тянет пакет System.Text.Json со своим генератором JSON, а в SDK такой уже есть:
       во временном проекте WPF-разметки оба запускаются и генерируют код дважды. -->
  <Target Name="RemoveDuplicateJsonGenerator" AfterTargets="ResolveLockFileAnalyzers">
    <ItemGroup>
      <Analyzer Remove="@(Analyzer)" Condition="'%(Analyzer.NuGetPackageId)' == 'System.Text.Json'" />
    </ItemGroup>
  </Target>

</Project>
