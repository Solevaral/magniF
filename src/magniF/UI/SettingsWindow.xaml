<Window x:Class="magniF.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:magniF.UI.Controls"
        xmlns:core="clr-namespace:magniF.Core"
        Title="magniF" Width="980" Height="740" MinWidth="820" MinHeight="540"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Bg}"
        Icon="pack://application:,,,/app.ico"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <c:EnumIsConverter x:Key="EnumIs" />
        <LinearGradientBrush x:Key="DeskBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF232A45" Offset="0" />
            <GradientStop Color="#FF1B1D29" Offset="0.55" />
            <GradientStop Color="#FF2A2033" Offset="1" />
        </LinearGradientBrush>
        <Style x:Key="Row" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,6" />
            <Setter Property="LastChildFill" Value="True" />
        </Style>
    </Window.Resources>

    <Grid Margin="26,18,26,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== шапка ===== -->
        <DockPanel Margin="0,0,0,18">
            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Toggle}" IsChecked="{Binding Enabled}" VerticalAlignment="Center">
                <TextBlock Text="{x:Static core:Strings.On}" Foreground="{StaticResource SubText}" />
            </CheckBox>
            <Image Source="pack://application:,,,/app.ico" Width="40" Height="40" Margin="0,0,14,0" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="magniF" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Text="{x:Static core:Strings.Subtitle}" Foreground="{StaticResource SubText}" FontSize="12.5" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="440" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="0.8*" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <ScrollViewer x:Name="Scroll" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
                <StackPanel>

                    <!-- ===== активация ===== -->
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="{x:Static core:Strings.SectionActivation}" Style="{StaticResource SectionHeader}" />
                            <DockPanel Style="{StaticResource Row}">
                                <Button x:Name="BindButton" DockPanel.Dock="Right" MinWidth="150" Click="OnBindClick"
                                        FontFamily="Cascadia Mono, Consolas" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Static core:Strings.HoldKey}" Style="{StaticResource Label}" />
                            </DockPanel>
                            <TextBlock Text="{x:Static core:Strings.HoldKeyHint}" Style="{StaticResource Hint}" />

                            <c:LabeledSlider Label="{x:Static core:Strings.Delay}" Minimum="0" Maximum="1000" Step="10"
                                             x:Name="DelaySlider" Value="{Binding ActivationDelay}" />
                            <TextBlock Text="{x:Static core:Strings.DelayHint}" Style="{StaticResource Hint}" />

                            <CheckBox Style="{StaticResource Toggle}" HorizontalAlignment="Stretch" Margin="0,6"
                                      IsChecked="{Binding WheelZoom}">
                                <TextBlock Text="{x:Static core:Strings.WheelZoom}" />
                            </CheckBox>
                            <c:LabeledSlider Label="{x:Static core:Strings.WheelStep}" Minimum="1.05" Maximum="2" Step="0.05"
                                             Format="×{0:0.00}" Value="{Binding ZoomStep}"
                                             IsEnabled="{Binding WheelZoom}" />
                        </StackPanel>
                    </Border>

                    <!-- ===== лупа ===== -->
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="{x:Static core:Strings.SectionLens}" Style="{StaticResource SectionHeader}" />
                            <c:LabeledSlider Label="{x:Static core:Strings.Zoom}" Minimum="1.1" Maximum="10" Step="0.1"
                                             Format="×{0:0.0}" Value="{Binding Zoom}" />
                            <CheckBox Style="{StaticResource Toggle}" HorizontalAlignment="Stretch" Margin="0,6"
                                      IsChecked="{Binding SmoothScaling}">
                                <TextBlock Text="{x:Static core:Strings.SmoothScaling}" />
                            </CheckBox>
                            <c:LabeledSlider x:Name="WidthSlider" Label="{x:Static core:Strings.Width}" Minimum="80" Maximum="1600" Step="10"
                                             Value="{Binding LensWidth}" />
                            <c:LabeledSlider x:Name="HeightSlider" Label="{x:Static core:Strings.Height}" Minimum="60" Maximum="1200" Step="10"
                                             Value="{Binding LensHeight}" />
                            <c:LabeledSlider x:Name="RadiusSlider" Label="{x:Static core:Strings.Radius}" Minimum="0" Maximum="150" Step="1"
                                             Value="{Binding CornerRadius}" />

                            <DockPanel Style="{StaticResource Row}">
                                <Border DockPanel.Dock="Right" Style="{StaticResource SegmentHost}">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Style="{StaticResource Segment}" GroupName="Indicator" Content="{x:Static core:Strings.IndicatorNone}"
                                                     IsChecked="{Binding Indicator, Converter={StaticResource EnumIs}, ConverterParameter=None}" />
                                        <RadioButton Style="{StaticResource Segment}" GroupName="Indicator" Content="{x:Static core:Strings.IndicatorDot}"
                                                     IsChecked="{Binding Indicator, Converter={StaticResource EnumIs}, ConverterParameter=Dot}" />
                                        <RadioButton Style="{StaticResource Segment}" GroupName="Indicator" Content="{x:Static core:Strings.IndicatorCross}"
                                                     IsChecked="{Binding Indicator, Converter={StaticResource EnumIs}, ConverterParameter=Crosshair}" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="{x:Static core:Strings.Indicator}" Style="{StaticResource Label}" />
                            </DockPanel>
                            <DockPanel Style="{StaticResource Row}">
                                <c:ColorField DockPanel.Dock="Right" Color="{Binding IndicatorColor}" />
                                <TextBlock Text="{x:Static core:Strings.IndicatorColor}" Style="{StaticResource Label}" />
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- ===== стиль ===== -->
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="{x:Static core:Strings.SectionStyle}" Style="{StaticResource SectionHeader}" />
                            <DockPanel Style="{StaticResource Row}">
                                <c:ColorField DockPanel.Dock="Right" Color="{Binding BorderColor}" />
                                <TextBlock Text="{x:Static core:Strings.BorderColor}" Style="{StaticResource Label}" />
                            </DockPanel>
                            <c:LabeledSlider x:Name="BorderSlider" Label="{x:Static core:Strings.BorderThickness}" Minimum="0" Maximum="24" Step="1"
                                             Value="{Binding BorderThickness}" />
                            <CheckBox Style="{StaticResource Toggle}" HorizontalAlignment="Stretch" Margin="0,8,0,6"
                                      IsChecked="{Binding ShadowEnabled}">
                                <TextBlock Text="{x:Static core:Strings.Shadow}" />
                            </CheckBox>
                            <c:LabeledSlider x:Name="ShadowSizeSlider" Label="{x:Static core:Strings.ShadowSize}" Minimum="2" Maximum="60" Step="1"
                                             Value="{Binding ShadowSize}" IsEnabled="{Binding ShadowEnabled}" />
                            <c:LabeledSlider Label="{x:Static core:Strings.ShadowOpacity}" Minimum="0" Maximum="100" Step="1"
                                             Format="{}{0:0} %" Value="{Binding ShadowOpacity}" IsEnabled="{Binding ShadowEnabled}" />
                        </StackPanel>
                    </Border>

                    <!-- ===== общее ===== -->
                    <Border Style="{StaticResource CardBorder}" Margin="0">
                        <StackPanel>
                            <TextBlock Text="{x:Static core:Strings.SectionGeneral}" Style="{StaticResource SectionHeader}" />
                            <DockPanel Style="{StaticResource Row}">
                                <Border DockPanel.Dock="Right" Style="{StaticResource SegmentHost}">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Style="{StaticResource Segment}" GroupName="Lang" Content="{x:Static core:Strings.LanguageAuto}"
                                                     IsChecked="{Binding Language, Converter={StaticResource EnumIs}, ConverterParameter=Auto}" />
                                        <RadioButton Style="{StaticResource Segment}" GroupName="Lang" Content="English"
                                                     IsChecked="{Binding Language, Converter={StaticResource EnumIs}, ConverterParameter=English}" />
                                        <RadioButton Style="{StaticResource Segment}" GroupName="Lang" Content="Русский"
                                                     IsChecked="{Binding Language, Converter={StaticResource EnumIs}, ConverterParameter=Russian}" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="{x:Static core:Strings.Language}" Style="{StaticResource Label}" />
                            </DockPanel>
                            <CheckBox x:Name="AutoStartToggle" Style="{StaticResource Toggle}" HorizontalAlignment="Stretch" Margin="0,6"
                                      Click="OnAutoStartClick">
                                <TextBlock Text="{x:Static core:Strings.AutoStart}" />
                            </CheckBox>
                            <Button Content="{x:Static core:Strings.ResetDefaults}" HorizontalAlignment="Left" Margin="0,10,0,0"
                                    Click="OnResetClick" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ===== превью ===== -->
            <Border Grid.Column="2" Style="{StaticResource CardBorder}" Margin="0" Padding="16">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{x:Static core:Strings.Preview}" Style="{StaticResource SectionHeader}" />
                    <TextBlock x:Name="PreviewHint" DockPanel.Dock="Bottom" Style="{StaticResource Hint}" Margin="2,12,0,0" />
                    <Border CornerRadius="10" ClipToBounds="True" Background="{StaticResource DeskBrush}">
                        <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                            <Grid x:Name="Desk">
                                <!-- фон-«рабочий стол», который увеличивает лупа -->
                                <Grid x:Name="Backdrop" Background="{StaticResource DeskBrush}">
                                    <Border x:Name="SampleWindow" Background="#FFF4F5F8" CornerRadius="8" Width="340" Height="300"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <StackPanel Margin="16,12">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                                <Ellipse Width="8" Height="8" Fill="#FFFF6B81" Margin="0,0,5,0" />
                                                <Ellipse Width="8" Height="8" Fill="#FFFFC857" Margin="0,0,5,0" />
                                                <Ellipse Width="8" Height="8" Fill="#FF5EE0B5" />
                                            </StackPanel>
                                            <TextBlock Text="Hold-to-zoom" Foreground="#FF1A1B22" FontSize="15" FontWeight="SemiBold" />
                                            <TextBlock Foreground="#FF505463" FontSize="8" TextWrapping="Wrap" Margin="0,6,0,0"
                                                       Text="The quick brown fox jumps over the lazy dog. Съешь же ещё этих мягких французских булок, да выпей чаю. 0123456789 — tiny text that is hard to read without a magnifier." />
                                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                <Border Background="#FF7C9CFF" CornerRadius="4" Padding="8,3">
                                                    <TextBlock Text="OK" Foreground="White" FontSize="8" />
                                                </Border>
                                                <Border Background="#FFE2E4EA" CornerRadius="4" Padding="8,3" Margin="6,0,0,0">
                                                    <TextBlock Text="Cancel" Foreground="#FF1A1B22" FontSize="8" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Foreground="#FF6A6E7C" FontSize="7" TextWrapping="Wrap" Margin="0,10,0,0"
                                                       Text="Lorem ipsum dolor sit amet, consectetur adipiscing elit. Integer posuere erat a ante venenatis dapibus. Maecenas sed diam eget risus varius blandit sit amet non magna." />
                                            <Grid Margin="0,10,0,0" Height="60">
                                                <Rectangle Fill="#FFE9ECF5" RadiusX="4" RadiusY="4" />
                                                <Polyline Stroke="#FF7C9CFF" StrokeThickness="1.5" Points="6,50 40,36 70,42 105,20 140,28 175,12 210,24 245,8 280,18 300,10" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- сама лупа -->
                                <Border x:Name="LensShadow" Background="Black" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Border x:Name="LensBody" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border.Background>
                                        <VisualBrush x:Name="LensBrush" Visual="{Binding ElementName=Backdrop}"
                                                     ViewboxUnits="Absolute" Stretch="Fill" />
                                    </Border.Background>
                                </Border>
                                <Canvas x:Name="Mark" Width="0" Height="0" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
                            </Grid>
                        </Viewbox>
                    </Border>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
